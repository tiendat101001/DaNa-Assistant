# DaNa agent — environment variables (canonical list). Copy to .env and fill in.
# Precedence: environment > .env / dana.toml > defaults. NEVER commit a real .env.
# Nested config uses "__": DANA_<SECTION>__<FIELD> (and __<SUBFIELD>).

# --- general ---
DANA_LANGUAGE=en                 # en | vi
DANA_LOG_LEVEL=INFO

# --- wake gate (Phase 2) ---
DANA_WAKE__PROVIDER=mock         # mock | porcupine | openwakeword
DANA_WAKE__PHRASE=Hey DaNa
DANA_WAKE__END_PHRASE=Bye DaNa
DANA_WAKE__INACTIVITY_TIMEOUT_S=30
# DANA_WAKE__API_KEY=            # Picovoice access key (porcupine)

# --- conversation core (Phase 3) ---
DANA_CONVERSATION__MODE=cascade  # cascade | s2s

# STT — latency-first default is Deepgram Nova-3 (streams en + vi)
DANA_CONVERSATION__STT__PROVIDER=mock       # mock | deepgram | assemblyai | faster_whisper
# DANA_CONVERSATION__STT__API_KEY=
# DANA_CONVERSATION__STT__BASE_URL=         # self-hosted WhisperLive, etc.

# LLM / brain — Gemini/OpenAI/Anthropic native; DeepSeek/Grok/Ollama via base_url
DANA_CONVERSATION__LLM__PROVIDER=mock       # mock | gemini | openai | anthropic | openai_compat
# DANA_CONVERSATION__LLM__MODEL=
# DANA_CONVERSATION__LLM__API_KEY=
# DANA_CONVERSATION__LLM__BASE_URL=         # https://api.deepseek.com , http://localhost:11434/v1 , ...

# TTS — ElevenLabs Flash v2.5 (supports vi); Piper/Kokoro local
DANA_CONVERSATION__TTS__PROVIDER=mock       # mock | elevenlabs | cartesia | openai | piper
# DANA_CONVERSATION__TTS__API_KEY=
# DANA_CONVERSATION__TTS__VOICE=

# S2S (only when MODE=s2s)
DANA_CONVERSATION__S2S__PROVIDER=mock       # mock | openai_realtime | gemini_live
# DANA_CONVERSATION__S2S__API_KEY=

# --- actions (Phase 5) ---
DANA_ACTIONS__PROVIDER=mock                 # mock | playwright
DANA_ACTIONS__GATE_POLICY=standard          # standard | conservative | wide

# --- control API (Phase 6) ---
DANA_CONTROL__HOST=127.0.0.1
DANA_CONTROL__PORT=8760

# --- privacy ---
DANA_PRIVACY__LOCAL_ONLY=false              # true = local provider set only, block cloud egress
