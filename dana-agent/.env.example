# DaNa agent — environment variables. Copy to .env and fill in.
# NEVER commit a real .env file.
#
# API keys use the vendor's standard names (same var the SDK reads directly).
# App settings use DANA_ prefix with __ for nesting.
# Priority: env > .env > dana.toml > defaults.

# ---------------------------------------------------------------------------
# API keys — standard vendor names (one entry covers multiple pipeline stages)
# ---------------------------------------------------------------------------

# AssemblyAI — used for both streaming STT and wake phrase detection
# ASSEMBLYAI_API_KEY=

# Google / Gemini — used for LLM (if provider=gemini) and Gemini TTS
# GEMINI_API_KEY=

# ElevenLabs — used for TTS (if provider=elevenlabs)
# ELEVENLABS_API_KEY=

# Deepgram — used for STT (if provider=deepgram)
# DEEPGRAM_API_KEY=

# OpenAI — used for LLM (if provider=openai) or S2S (openai_realtime)
# OPENAI_API_KEY=

# Anthropic — used for LLM (if provider=anthropic)
# ANTHROPIC_API_KEY=

# Override a specific stage with a different key than the standard name:
# DANA_CONVERSATION__STT__API_KEY=
# DANA_CONVERSATION__TTS__API_KEY=
# DANA_CONVERSATION__LLM__API_KEY=
# DANA_WAKE__API_KEY=

# ---------------------------------------------------------------------------
# App settings (DANA_ prefix)
# ---------------------------------------------------------------------------

DANA_LANGUAGE=en                 # en | vi
DANA_LOG_LEVEL=INFO

# --- wake gate ---
DANA_WAKE__PHRASE=Hey DaNa
DANA_WAKE__END_PHRASE=Bye DaNa
DANA_WAKE__INACTIVITY_TIMEOUT_S=30

# --- conversation core ---
DANA_CONVERSATION__MODE=cascade  # cascade | s2s

# STT
DANA_CONVERSATION__STT__PROVIDER=assemblyai  # assemblyai | deepgram | faster_whisper | mock
# DANA_CONVERSATION__STT__BASE_URL=          # self-hosted WhisperLive, etc.

# LLM / brain
DANA_CONVERSATION__LLM__PROVIDER=gemini      # gemini | openai | anthropic | mock
# DANA_CONVERSATION__LLM__MODEL=
# DANA_CONVERSATION__LLM__BASE_URL=          # https://api.deepseek.com, http://localhost:11434/v1, …

# TTS
DANA_CONVERSATION__TTS__PROVIDER=gemini      # gemini | elevenlabs | mock
# DANA_CONVERSATION__TTS__VOICE=
# TTS request batching — controls how many sentences are accumulated per API call.
#   0 = whole reply in one request (1 call/turn — best for free-tier rate limits)
#   1 = one sentence per request    (lowest audio latency, most API calls) [default]
#   N = N sentences per request     (balance)
# DANA_CONVERSATION__TTS__CHUNK_SENTENCES=1

# Half-duplex mode — disables STT while the bot is speaking to prevent loopback.
# Enable this when the bot's TTS audio leaks back into the microphone and gets
# transcribed as user speech.  Trades barge-in ability for echo safety.
# DANA_CONVERSATION__NO_INTERRUPT=false

# S2S (only when MODE=s2s)
DANA_CONVERSATION__S2S__PROVIDER=mock        # openai_realtime | gemini_live | mock

# --- brain ---
DANA_BRAIN__MAX_STEPS=8
DANA_BRAIN__MEMORY__BACKEND=memory           # memory | sqlite
DANA_BRAIN__MEMORY__SQLITE_PATH=.dana/brain.sqlite
DANA_BRAIN__HISTORY_STRATEGY=trim
DANA_BRAIN__HISTORY_TRIGGER_MESSAGES=20
DANA_BRAIN__HISTORY_KEEP_LAST=8

# --- actions ---
DANA_ACTIONS__PROVIDER=mock                  # mock | browser | os
DANA_ACTIONS__GATE_POLICY=standard           # standard | conservative | wide
# Default-deny allowlists (empty = nothing navigable/launchable). JSON arrays:
# DANA_ACTIONS__ALLOWED_DOMAINS=["example.com"]   # host-suffix match, http(s) only
# DANA_ACTIONS__ALLOWED_APPS=["notepad","spotify"]
# DANA_ACTIONS__MAX_ACTIONS_PER_TURN=10
# Browser (Playwright) provider — dedicated, disposable profile (NOT real Chrome).
# DANA_ACTIONS__BROWSER_PROFILE_DIR=.dana/browser-profile
# DANA_ACTIONS__BROWSER_STORAGE_STATE_PATH=.dana/browser-state.json
# DANA_ACTIONS__BROWSER_HEADLESS=false
# OS (Windows) actions are dangerous → OFF unless explicitly enabled.
# DANA_ACTIONS__OS_ACTIONS_ENABLED=false
# Durable append-only JSONL audit trail.
# DANA_ACTIONS__AUDIT_PATH=.dana/audit.jsonl

# --- control API ---
DANA_CONTROL__HOST=127.0.0.1
DANA_CONTROL__PORT=8760

# --- privacy ---
DANA_PRIVACY__LOCAL_ONLY=false               # true = block all cloud egress
