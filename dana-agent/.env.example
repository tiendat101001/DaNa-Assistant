# DaNa agent — environment variables. Copy to .env and fill in.
# NEVER commit a real .env file.
#
# API keys use the vendor's standard names (same var the SDK reads directly).
# App settings use DANA_ prefix with __ for nesting.
# Priority: env > .env > dana.toml > defaults.

# ---------------------------------------------------------------------------
# API keys — standard vendor names (one entry covers multiple pipeline stages)
# ---------------------------------------------------------------------------

# AssemblyAI — used for both streaming STT and wake phrase detection
# ASSEMBLYAI_API_KEY=

# Google / Gemini — used for LLM (if provider=gemini) and Gemini TTS
# GEMINI_API_KEY=

# ElevenLabs — used for TTS (if provider=elevenlabs)
# ELEVENLABS_API_KEY=

# Deepgram — used for STT (if provider=deepgram)
# DEEPGRAM_API_KEY=

# OpenAI — used for LLM (if provider=openai) or S2S (openai_realtime)
# OPENAI_API_KEY=

# Anthropic — used for LLM (if provider=anthropic)
# ANTHROPIC_API_KEY=

# Hugging Face — only for GATED repos / higher rate limits. Public
# litert-community models need no token. Used by the Models tab (pull).
# HF_TOKEN=

# Together AI (OpenAI-compatible) — fast hosted LLM, provider=together
# TG_API_KEY=
# TG_BASE_URL=https://api.together.xyz/v1
# TG_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Override a specific stage with a different key than the standard name:
# DANA_CONVERSATION__STT__API_KEY=
# DANA_CONVERSATION__TTS__API_KEY=
# DANA_CONVERSATION__LLM__API_KEY=
# DANA_WAKE__API_KEY=

# ---------------------------------------------------------------------------
# App settings (DANA_ prefix)
# ---------------------------------------------------------------------------

DANA_LANGUAGE=en                 # en | vi
DANA_LOG_LEVEL=INFO

# --- wake gate ---
DANA_WAKE__PHRASE=Hey DaNa
DANA_WAKE__END_PHRASE=Bye DaNa
DANA_WAKE__INACTIVITY_TIMEOUT_S=30

# --- conversation core ---
DANA_CONVERSATION__MODE=cascade  # cascade | s2s

# STT
DANA_CONVERSATION__STT__PROVIDER=assemblyai  # assemblyai | deepgram | faster_whisper | litert | mock
# On-device LiteRT STT (no key, no network at runtime). Pull the model first
# from the UI Models tab. Models: litert-community/moonshine-tiny (fastest),
# litert-community/whisper-tiny (multilingual).
# DANA_CONVERSATION__STT__PROVIDER=litert
# DANA_CONVERSATION__STT__MODEL=litert-community/moonshine-tiny
# DANA_CONVERSATION__STT__BACKEND=cpu        # cpu | webgpu
# DANA_CONVERSATION__STT__NUM_THREADS=4
# DANA_CONVERSATION__STT__BASE_URL=          # self-hosted WhisperLive, etc.

# LLM / brain
DANA_CONVERSATION__LLM__PROVIDER=gemini      # gemini | openai | anthropic | together | sglang | mock
# DANA_CONVERSATION__LLM__MODEL=
# DANA_CONVERSATION__LLM__BASE_URL=          # https://api.deepseek.com, http://localhost:11434/v1, …
# Fast hosted example (Together; key/base URL/model fall back to TG_* above):
# DANA_CONVERSATION__LLM__PROVIDER=together
# DANA_CONVERSATION__LLM__MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Self-hosted SGLang / vLLM (same OpenAI-compatible provider, just a URL):
# DANA_CONVERSATION__LLM__PROVIDER=sglang
# DANA_CONVERSATION__LLM__BASE_URL=http://localhost:30000/v1
# DANA_CONVERSATION__LLM__MODEL=Qwen/Qwen3-8B
# Latency-relevant LLM knobs:
# DANA_CONVERSATION__LLM__MAX_TOKENS=300
# DANA_CONVERSATION__LLM__TIMEOUT_S=20

# TTS
DANA_CONVERSATION__TTS__PROVIDER=gemini      # gemini | elevenlabs | piper | litert | mock
# On-device LiteRT TTS (English only): kitten-tts-nano-0.8 (tiny, fast).
# DANA_CONVERSATION__TTS__PROVIDER=litert
# DANA_CONVERSATION__TTS__MODEL=litert-community/kitten-tts-nano-0.8
# DANA_CONVERSATION__TTS__NUM_THREADS=4
# Vietnamese TTS: use Piper with a vi_VN voice (LiteRT TTS has no Vietnamese).
# DANA_CONVERSATION__TTS__PROVIDER=piper
# DANA_CONVERSATION__TTS__VOICE=vi_VN-vais1000-medium
# DANA_CONVERSATION__TTS__VOICE=
# TTS request batching — controls how many sentences are accumulated per API call.
#   0 = whole reply in one request (1 call/turn — best for free-tier rate limits)
#   1 = one sentence per request    (lowest audio latency, most API calls) [default]
#   N = N sentences per request     (balance)
# DANA_CONVERSATION__TTS__CHUNK_SENTENCES=1

# Half-duplex mode — disables STT while the bot is speaking to prevent loopback.
# Enable this when the bot's TTS audio leaks back into the microphone and gets
# transcribed as user speech.  Trades barge-in ability for echo safety.
# DANA_CONVERSATION__NO_INTERRUPT=false

# S2S (only when MODE=s2s)
DANA_CONVERSATION__S2S__PROVIDER=mock        # openai_realtime | gemini_live | mock

# --- brain ---
# --- realtime / latency budget (end-of-speech -> first audio) ---
# DANA_CONVERSATION__LATENCY__TARGET_FIRST_AUDIO_MS=600
# DANA_CONVERSATION__LATENCY__VAD_STOP_SECS=0.2         # lower = faster, may cut you off
# DANA_CONVERSATION__LATENCY__VAD_START_SECS=0.2
# DANA_CONVERSATION__LATENCY__VAD_CONFIDENCE=0.7
# DANA_CONVERSATION__LATENCY__TTS_FIRST_CHUNK_MIN_CHARS=20   # eager first clause to TTS; 0 = off
# DANA_CONVERSATION__LATENCY__WARMUP_ON_START=true

# --- local model registry (Models tab) ---
# DANA_MODELS__MODELS_DIR=.dana/models
# DANA_MODELS__HUB_AUTHOR=litert-community
# DANA_MODELS__MAX_CONCURRENT_PULLS=2

DANA_BRAIN__MAX_STEPS=8
DANA_BRAIN__MEMORY__BACKEND=memory           # memory | sqlite
DANA_BRAIN__MEMORY__SQLITE_PATH=.dana/brain.sqlite
DANA_BRAIN__HISTORY_STRATEGY=trim
DANA_BRAIN__HISTORY_TRIGGER_MESSAGES=20
DANA_BRAIN__HISTORY_KEEP_LAST=8

# --- actions ---
DANA_ACTIONS__PROVIDER=mock                  # mock | browser | os
DANA_ACTIONS__GATE_POLICY=standard           # standard | conservative | wide
# Default-deny allowlists (empty = nothing navigable/launchable). JSON arrays:
# DANA_ACTIONS__ALLOWED_DOMAINS=["example.com"]   # host-suffix match, http(s) only
# DANA_ACTIONS__ALLOWED_APPS=["notepad","spotify"]
# DANA_ACTIONS__MAX_ACTIONS_PER_TURN=10
# Extra named search engines ({q} = URL-encoded query; host must be allowlisted):
# DANA_ACTIONS__SEARCH_ENGINES={"shopee":"https://shopee.vn/search?keyword={q}"}
# MCP tool servers (every tool goes through the same safety gate; readOnlyHint
# tools run freely, everything else asks first). JSON array:
# DANA_ACTIONS__MCP_SERVERS=[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","C:/Users/me/Documents"],"trust":"annotations"}]
# HTTP server: {"name":"docs","transport":"streamable_http","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ..."}}
# trust="confirm_all" forces confirmation for every tool of that server.
# Browser (Playwright) provider — dedicated, disposable profile (NOT real Chrome).
# DANA_ACTIONS__BROWSER_PROFILE_DIR=.dana/browser-profile
# DANA_ACTIONS__BROWSER_STORAGE_STATE_PATH=.dana/browser-state.json
# DANA_ACTIONS__BROWSER_HEADLESS=false
# OS (Windows) actions are dangerous → OFF unless explicitly enabled.
# DANA_ACTIONS__OS_ACTIONS_ENABLED=false
# Durable append-only JSONL audit trail.
# DANA_ACTIONS__AUDIT_PATH=.dana/audit.jsonl

# --- control API ---
DANA_CONTROL__HOST=127.0.0.1
DANA_CONTROL__PORT=8760

# --- privacy ---
DANA_PRIVACY__LOCAL_ONLY=false               # true = block all cloud egress
